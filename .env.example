# File di configurazione variabili d'ambiente
# Copia questo file come .env e inserisci i tuoi valori

# Chiave API di Anthropic (Claude AI)
# Ottieni la tua chiave su: https://console.anthropic.com/
# OPZIONALE: Serve solo per il generatore automatico di verifiche
ANTHROPIC_API_KEY=

# Chiave segreta Flask (per sessioni e sicurezza)
# In produzione, usa una chiave casuale e complessa
SECRET_KEY=dev-secret-key-change-in-production

# Database URL (opzionale, default: SQLite locale)
# DATABASE_URL=sqlite:///instance/didattica.db
